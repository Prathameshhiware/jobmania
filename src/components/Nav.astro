---
import { CATEGORIES } from '../lib/format.js';
const here = Astro.url.pathname;
---
<nav class="nav glass" aria-label="Main">
  <div class="nav-top">
    <a class="brand" href="/">Jo<b>B</b>mania</a>
    <span class="spacer"></span>
    <a class="plain" href="/jobs">All jobs</a>
    <a class="btn" href="/c/walk-ins">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
      Walk-ins
    </a>
  </div>
  <div class="cats">
    <a href="/" aria-current={here === '/' ? 'page' : undefined}>Home</a>
    {CATEGORIES.map((c) => (
      <a href={`/c/${c.slug}`} aria-current={here === `/c/${c.slug}` ? 'page' : undefined}>{c.label}</a>
    ))}
  </div>
</nav>

<style>
  .nav { margin-top: 20px; border-radius: 24px; }
  .nav-top { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 10px 18px; }
  .brand { font-family: var(--display); font-size: 24px; font-weight: 800; letter-spacing: -0.05em; color: var(--ink); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .brand b { color: var(--accent); font-weight: 800; }
  .spacer { flex: 1 1 auto; }
  /* 44px touch target without changing how the link looks */
  .plain { font-size: 14px; font-weight: 500; color: var(--ink-2); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; padding-inline: 4px; }

  .cats { display: flex; gap: 24px; padding: 0 18px 2px; border-top: 1px solid var(--glass-edge); }
  .cats a {
    display: inline-flex; align-items: center; min-height: 46px;
    font-size: 14px; font-weight: 500; color: var(--ink-2); text-decoration: none;
    border-bottom: 2.5px solid transparent; white-space: nowrap;
  }
  .cats a[aria-current] { color: var(--ink); font-weight: 700; border-bottom-color: var(--accent); }

  /* On a phone eight categories wrap to three lines and push the page down.
     A single scrolling row is the familiar pattern and keeps the nav one line. */
  @media (max-width: 720px) {
    .cats {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      gap: 18px;
      /* bleed to the card edge so the row reads as scrollable */
      margin-inline: -18px;
      padding-inline: 18px;
    }
    .cats::-webkit-scrollbar { display: none; }
    .cats a { scroll-snap-align: start; }
    .nav-top { gap: 10px; }
    .brand { font-size: 21px; }
  }
</style>
