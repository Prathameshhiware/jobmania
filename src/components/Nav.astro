---
import { CATEGORIES } from '../lib/format.js';
const here = Astro.url.pathname;
---
<nav class="nav glass" aria-label="Main">
  <div class="nav-top">
    <a class="brand" href="/">Jo<b>B</b>mania</a>
    <span class="spacer"></span>
    <a class="plain" href="/jobs">All jobs</a>
    <a class="btn" href="/c/walk-ins">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
      Walk-ins
    </a>
  </div>

  <div class="cats">
    <a href="/" aria-current={here === '/' ? 'page' : undefined}>Home</a>
    {CATEGORIES.map((c) => (
      <a href={`/c/${c.slug}`} aria-current={here === `/c/${c.slug}` ? 'page' : undefined}>{c.label}</a>
    ))}
  </div>

  {/* Phone menu. <details> rather than a button and a script, so the links are
      reachable before — or without — JavaScript. The panel sits in normal flow
      under the bar, which keeps it inside the card instead of floating over the
      page in its own stacking context, where a backdrop filter inside a backdrop
      filter renders inconsistently across browsers. */}
  <details class="menu">
    <summary aria-label="Menu">
      <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </summary>
    <div class="menu-panel">
      <div class="menu-grid">
        <a href="/" aria-current={here === '/' ? 'page' : undefined}>Home</a>
        {CATEGORIES.map((c) => (
          <a href={`/c/${c.slug}`} aria-current={here === `/c/${c.slug}` ? 'page' : undefined}>{c.label}</a>
        ))}
      </div>
      <div class="menu-foot">
        <a class="menu-all" href="/jobs" aria-current={here === '/jobs' ? 'page' : undefined}>All jobs</a>
        <a class="btn" href="/c/walk-ins">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
          Walk-ins
        </a>
      </div>
    </div>
  </details>
</nav>

<style>
  .nav { position: relative; margin-top: 20px; border-radius: 24px; }
  .nav-top { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 10px 18px; }
  .brand { font-family: var(--display); font-size: 24px; font-weight: 800; letter-spacing: -0.05em; color: var(--ink); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .brand b { color: var(--accent); font-weight: 800; }
  .spacer { flex: 1 1 auto; }
  /* 44px touch target without changing how the link looks */
  .plain { font-size: 14px; font-weight: 500; color: var(--ink-2); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; padding-inline: 4px; }

  .cats { display: flex; gap: 24px; padding: 0 18px 2px; border-top: 1px solid var(--glass-edge); }
  .cats a {
    display: inline-flex; align-items: center; min-height: 46px;
    font-size: 14px; font-weight: 500; color: var(--ink-2); text-decoration: none;
    border-bottom: 2.5px solid transparent; white-space: nowrap;
  }
  .cats a[aria-current] { color: var(--ink); font-weight: 700; border-bottom-color: var(--accent); }

  /* The menu only exists on narrow screens. */
  .menu { display: none; }

  /*
    Below this width the eight category links no longer fit on one row, and the
    bar's own links wrap the Walk-ins button onto a second line. Both collapse
    into the menu instead.
  */
  @media (max-width: 860px) {
    .nav-top { flex-wrap: nowrap; padding-right: 66px; }
    .plain, .cats { display: none; }
    .nav-top > .btn { display: none; }
    .brand { font-size: 21px; }

    .menu { display: block; }

    /* The toggle belongs beside the brand, but the panel has to open below the
       whole bar — so the bar stays in flow and only the 44px control is lifted
       into it. */
    summary {
      position: absolute; top: 10px; right: 14px;
      width: 44px; height: 44px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 13px; cursor: pointer;
      list-style: none; -webkit-tap-highlight-color: transparent;
    }
    summary::-webkit-details-marker { display: none; }
    summary::marker { content: ''; }

    .burger { display: block; width: 19px; height: 13px; position: relative; }
    .burger i {
      position: absolute; left: 0; width: 100%; height: 2px; border-radius: 2px;
      background: var(--ink);
      transition: transform 0.22s ease, opacity 0.16s ease, top 0.22s ease;
    }
    .burger i:nth-child(1) { top: 0; }
    .burger i:nth-child(2) { top: 5.5px; }
    .burger i:nth-child(3) { top: 11px; }

    /* Open: the outer bars meet in the middle and cross, the middle one goes. */
    .menu[open] .burger i:nth-child(1) { top: 5.5px; transform: rotate(45deg); }
    .menu[open] .burger i:nth-child(2) { opacity: 0; }
    .menu[open] .burger i:nth-child(3) { top: 5.5px; transform: rotate(-45deg); }
    .menu[open] summary { background: var(--glass-chip); }

    .menu-panel { padding: 14px 18px 18px; border-top: 1px solid var(--glass-edge); }
    .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); gap: 2px 14px; }
    .menu-grid a {
      display: flex; align-items: center; min-height: 46px;
      font-size: 15px; font-weight: 500; color: var(--ink-2); text-decoration: none;
    }
    .menu-grid a[aria-current] { color: var(--ink); font-weight: 700; }

    .menu-foot { display: flex; align-items: center; gap: 12px; margin-top: 12px; padding-top: 14px; border-top: 1px solid var(--hairline); }
    .menu-all { flex: 1 1 auto; display: flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--ink); text-decoration: none; }
    .menu-foot .btn { min-height: 44px; }
  }

  /* Opening the menu slides the panel in, unless the reader has asked for less
     motion. Height is not animatable from auto, so the panel fades and lifts. */
  @media (max-width: 860px) and (prefers-reduced-motion: no-preference) {
    .menu[open] .menu-panel { animation: menu-in 0.2s ease; }
    @keyframes menu-in {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: none; }
    }
  }
</style>

<script>
  // Enhancements only — <details> already opens and closes on its own.
  const menu = document.querySelector<HTMLDetailsElement>('nav.nav .menu');
  if (menu) {
    // Escape closes it and puts focus back on the control, which <details>
    // does not do by itself.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    // A tap anywhere else closes it, the way a dropdown is expected to behave.
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    // Widening past the breakpoint hides the control, so leaving the panel open
    // would strand it visible with no way to close it.
    matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
      if (e.matches) menu.open = false;
    });
  }
</script>
