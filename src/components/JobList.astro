---
import JobCard from './JobCard.astro';

const { heading, sub, jobs = [], empty = 'Nothing live here right now.', crumb, total } = Astro.props;

// `total` is the real number of matching rows; `jobs` is capped at a page size.
// Say so rather than letting the count on the page contradict the title.
const all = total ?? jobs.length;
const capped = all > jobs.length;
---
{crumb && (
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>›<span>{crumb}</span>
  </nav>
)}

<header class="lead">
  <h1>{heading}</h1>
  <p class="sub">{sub}</p>
  <p class="count">
    <span class="dot"></span>
    {all} live opening{all === 1 ? '' : 's'}
    {capped ? ` · showing the ${jobs.length} most recent` : ''}
    {all ? ' · all link-checked within the last 24 hours' : ''}
  </p>
</header>

{jobs.length
  ? <div class="grid-job">{jobs.map((job) => <JobCard job={job} />)}</div>
  : <p class="empty glass">{empty}</p>}

<style>
  .crumbs { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; font-size: 13px; color: var(--ink-3); padding-block: 22px 0; }
  .crumbs a { color: var(--ink-2); text-decoration: none; font-weight: 500; }
  .lead { padding-block: 40px 30px; max-width: 70ch; }
  .lead h1 { font-size: clamp(30px, 5vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -0.05em; }
  .sub { margin: 16px 0 0; font-size: 16px; font-weight: 500; color: var(--ink-2); }
  .count { display: inline-flex; align-items: center; gap: 9px; margin: 18px 0 0; font-size: 13px; font-weight: 600; color: var(--ok-ink); }
  .grid-job { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .empty { border-radius: 22px; padding: 28px; margin: 0; color: var(--ink-2); }
</style>
