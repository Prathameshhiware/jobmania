---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { clean } from '../lib/seo.js';

const {
  title,
  description = 'Job openings that are still actually open. Every listing re-checked daily against the employer’s own careers page.',
  canonical,
  noindex = false,
  maxAge = 300,
  schema = [],          // array of JSON-LD objects for this page
} = Astro.props;

// Edge-cache briefly, then revalidate in the background. Freshness is the
// product, so nothing is cached for long.
Astro.response.headers.set('Cache-Control', `public, max-age=0, s-maxage=${maxAge}, stale-while-revalidate=600`);

const origin = (Astro.site?.origin ?? 'https://jobmania.vercel.app').replace(/\/$/, '');
const href = canonical ?? new URL(Astro.url.pathname, `${origin}/`).href;
const blocks = (Array.isArray(schema) ? schema : [schema]).filter(Boolean);

// Analytics only in production, and only when an id is configured.
const GA_ID = import.meta.env.PROD
  ? (import.meta.env.PUBLIC_GA_ID ?? process.env?.PUBLIC_GA_ID ?? null)
  : null;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={href}>

  {/* max-snippet:-1 lets answer engines quote the full passage rather than a
      truncated one, which is the single most useful directive for being cited. */}
  {noindex
    ? <meta name="robots" content="noindex, follow">
    : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">}

  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.svg">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#262338">

  {/* Google Analytics.
      Gated on the measurement id existing AND the build being production, so a
      dev server or a preview deployment never writes into the same property as
      real traffic. The id lives in an environment variable rather than the
      source: it is not a secret, but keeping it out of the repo means a second
      environment can point somewhere else without a code change.
      googletagmanager.com is the one external script host allowed by the CSP in
      middleware.js; without that entry this is blocked and silently does
      nothing. */}
  {GA_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      {/* set:html rather than define:vars, because define:vars wraps the body
          in a block and gtag ends up scoped to it. Page views still fire, but
          nothing else on the site can call gtag() afterwards, which quietly
          rules out tracking an apply click or any other custom event later. */}
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', '${GA_ID}');
      `}></script>
    </>
  )}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="JoBmania">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={href}>
  <meta property="og:locale" content="en_IN">
  <meta property="og:image" content={`${origin}/icon.svg`}>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap">

  {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(clean(b))} />)}

  <slot name="head" />
</head>
<body>
  <div class="wrap">
    <Nav />
    <slot />
    <Footer />
  </div>
</body>
</html>
