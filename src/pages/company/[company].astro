---
import Base from '../../layouts/Base.astro';
import JobList from '../../components/JobList.astro';
import { getByCompany } from '../../lib/db.js';

import {
  titles, descriptions, breadcrumbSchema, itemListSchema, collectionPageSchema,
} from '../../lib/seo.js';
import { citySlug } from '../../lib/format.js';

const { company } = Astro.params;
const jobs = await getByCompany(company, 60);
if (!jobs.length) return Astro.redirect('/404', 404);

const name = jobs[0].company_name;
const cities = [...new Set(jobs.map((j) => j.city_primary).filter(Boolean))];
const sub = descriptions.company(name, jobs.length, cities.slice(0, 4).join(', '));

const origin = (Astro.site?.origin ?? 'https://jobmania.vercel.app').replace(/\/$/, '');
const path = `/company/${company}`;
---
<Base
  title={titles.company(name, jobs.length)}
  description={sub}
  noindex={jobs.length < 2}
  schema={[
    collectionPageSchema(origin, { path, name: `${name} careers`, description: sub }),
    breadcrumbSchema(origin, [{ name: 'Home', path: '/' }, { name }]),
    itemListSchema(origin, jobs, { name: `Open roles at ${name}` }),
  ]}
>
  <JobList heading={`Jobs at ${name}`} sub={sub} jobs={jobs} crumb={name} />

  {cities.length > 0 && (
    <section class="cross">
      <h2>{name} openings by city</h2>
      <div class="row">
        {cities.map((c) => <a class="chip" href={`/city/${citySlug(c)}`}>Jobs in {c}</a>)}
      </div>
    </section>
  )}
</Base>

<style>
  .cross { padding-block: 48px 0; }
  .cross h2 { font-size: 18px; font-weight: 800; margin-bottom: 14px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
