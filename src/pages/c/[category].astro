---
import Base from '../../layouts/Base.astro';
import JobList from '../../components/JobList.astro';
import { getByFacet, getLatest } from '../../lib/db.js';
import { CATEGORIES, citySlug } from '../../lib/format.js';
import { getFacets, countByFacet } from '../../lib/db.js';
import {
  titles, descriptions, breadcrumbSchema, itemListSchema, collectionPageSchema,
} from '../../lib/seo.js';

const { category } = Astro.params;
const cat = CATEGORIES.find((c) => c.slug === category);
if (!cat) return Astro.redirect('/404', 404);

const [jobs, facets, matched] = await Promise.all([
  cat.slug === 'just-posted' ? getLatest(60) : getByFacet(cat.facet, 60),
  getFacets(),
  cat.slug === 'just-posted' ? null : countByFacet(cat.facet),
]);

// The listing is capped at a page size; this is the real number.
const total = matched ?? facets.total;

// On-page intro copy. The meta description is built separately from the
// category's own `detail` clause so the two read naturally in their own place.
const BLURB = {
  'just-posted': 'The newest openings on JoBmania, most recent first. Every one was checked against the employer’s own page before it appeared here.',
  'freshers': 'Roles open to candidates with no prior experience, including off-campus drives and trainee positions.',
  'experienced': 'Roles asking for a few years behind you rather than a clean slate.',
  'remote': 'Work-from-home and remote roles hiring across India.',
  'walk-ins': 'Attend in person, with no online application. Check the venue and timing on each listing, and confirm with the employer before you travel.',
  'internships': 'Internships and apprenticeships, including stipend-paying and pre-placement roles.',
  'off-campus': 'Off-campus drives open to graduates outside a college placement process.',
};

const origin = (Astro.site?.origin ?? 'https://jobmania.vercel.app').replace(/\/$/, '');
const path = `/c/${cat.slug}`;
const heading = `${cat.label} jobs`;
const desc = descriptions.category(cat.phrase, cat.detail, total);
---
<Base
  title={titles.category(cat.phrase, total)}
  description={desc}
  noindex={total < 3}
  schema={[
    collectionPageSchema(origin, { path, name: `${heading} in India`, description: desc }),
    breadcrumbSchema(origin, [{ name: 'Home', path: '/' }, { name: cat.label }]),
    jobs.length ? itemListSchema(origin, jobs, { name: `${cat.label} job openings in India` }) : null,
  ]}
>
  <JobList
    heading={heading}
    sub={BLURB[cat.slug]}
    jobs={jobs}
    total={total}
    crumb={cat.label}
    empty="No live openings in this category right now. The monitor runs every five minutes, so check back shortly."
  />

  <section class="cross">
    <h2>{cat.label} jobs by city</h2>
    <div class="row">
      {facets.cities.map(([n, k]) => (
        <a class="chip" href={`/city/${citySlug(n)}/${cat.slug}`}>{cat.label} in {n}</a>
      ))}
    </div>
  </section>
</Base>

<style>
  .cross { padding-block: 48px 0; }
  .cross h2 { font-size: 18px; font-weight: 800; margin-bottom: 14px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
