---
// Today's reel, ready to post.
//
// Deliberately only the video. There were carousel cards and still frames
// here as well, and they turned the page into a menu when it needs to be one
// action: watch it, save it, copy the caption, post it. The cards are still
// built and still served from /social/<date>/<n>.png — they are just not what
// this page is for.
//
// The caption shown is the one uploaded beside the video, not one re-derived
// here. Re-deriving would drift silently: a reel covers one subject, chosen
// against what has already gone out, and a caption built fresh on page load
// could easily describe a different one.
//
// noindex. A tool for whoever runs the account, not a page for readers.

import Base from '../../layouts/Base.astro';
import { db } from '../../lib/supabase.js';
import { istLong, istDate } from '../../lib/ist.js';

const day = istDate();

/*
 * The reel is encoded on a real machine, because Vercel cannot do video. This
 * page only looks for one. Not finding it is the normal state on a day the
 * script has not run, and it says so rather than showing a dead player.
 */
let reel = null;
let caption = '';
let failed = null;

try {
  const { data, error } = await db.storage.from('reels').list('', { limit: 300 });
  if (error) throw new Error(error.message);

  const todays = (data ?? [])
    .filter((f) => f.name.startsWith(`${day}-`) && f.name.endsWith('.mp4'))
    .sort((a, b) => String(b.updated_at ?? '').localeCompare(String(a.updated_at ?? '')));

  if (todays[0]) {
    const name = todays[0].name;
    const base = name.replace(/\.mp4$/, '');
    reel = {
      name,
      pillar: base.slice(day.length + 1),
      url: db.storage.from('reels').getPublicUrl(name).data.publicUrl,
      mb: todays[0].metadata?.size ? (todays[0].metadata.size / 1048576).toFixed(1) : null,
    };
    const txt = await fetch(db.storage.from('reels').getPublicUrl(`${base}.txt`).data.publicUrl);
    if (txt.ok) caption = (await txt.text()).trim();
  }
} catch (err) {
  failed = String(err?.message ?? err);
}

/*
 * Caption and hashtags get separate copy buttons.
 *
 * They are pasted into different boxes — the caption into the post, the tags
 * often into the first comment — and nobody wants to hand-select a line of
 * forty words on a phone.
 */
const lines = caption.split('\n');
const tagLine = [...lines].reverse().find((l) => l.trim().startsWith('#'))?.trim() ?? '';
const withoutTags = caption.replace(tagLine, '').replace(/\n+$/, '').trim();
const [post, note = ''] = withoutTags.split('\n--\n');
---

<Base
  title={`Today's reel — ${reel?.pillar ?? 'JoBmania'}`}
  description="The daily Instagram reel, ready to post."
  noindex={true}
  maxAge={0}
>
  <main class="wrap">
    <header class="head">
      <p class="eyebrow">Reel · {istLong(day)}</p>
      <h1>{reel ? 'Ready to post' : 'Not built yet'}</h1>
      {reel && (
        <p class="meta">
          <span class="pill">{reel.pillar}</span>
          {reel.mb && <span class="dim">{reel.mb} MB</span>}
        </p>
      )}
    </header>

    {failed && <p class="err">Could not reach storage: {failed}</p>}

    {!reel && !failed && (
      <p class="err">
        Run <code>npm run reel:deliver</code> and reload. The video is encoded on a real
        machine — Vercel cannot do it.
      </p>
    )}

    {reel && (
      <>
        <video src={reel.url} controls playsinline preload="metadata" class="reel"></video>

        <div class="actions">
          <a class="btn primary" href={reel.url} download={reel.name}>Save video</a>
          <button type="button" class="btn" data-copy="post">Copy caption</button>
          <button type="button" class="btn" data-copy="tags">Copy hashtags</button>
        </div>

        <section class="block">
          <h2>Caption</h2>
          <pre id="post">{post}</pre>
        </section>

        {tagLine && (
          <section class="block">
            <h2>Hashtags</h2>
            <pre id="tags">{tagLine}</pre>
          </section>
        )}

        <p class="note">
          Share it as a Reel, not a post, and add a trending sound in the app first. Music
          cannot be attached by any API, Meta’s own included, and a silent reel gets a
          fraction of the reach.
        </p>
      </>
    )}
  </main>
</Base>

<style>
  .wrap { max-width: 560px; margin: 0 auto; padding: 28px 16px 72px; }
  .head { margin-bottom: 20px; }
  .eyebrow {
    font-size: .78rem; letter-spacing: .13em; text-transform: uppercase;
    color: var(--ink-3); margin: 0 0 8px;
  }
  h1 { font-family: var(--display); font-size: clamp(1.6rem, 6vw, 2.2rem); line-height: 1.12; margin: 0; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 12px 0 0; }
  .pill {
    font-size: .78rem; font-weight: 700; padding: 5px 12px; border-radius: 999px;
    background: var(--glass-chip); border: 1px solid var(--hairline); color: var(--ink-2);
  }
  .dim { font-size: .82rem; color: var(--ink-3); }
  .err {
    padding: 16px; border-radius: 12px; background: var(--warn-soft);
    border: 1px solid var(--warn-line); color: var(--warn-ink); line-height: 1.5;
  }
  code {
    font-size: .9em; padding: 2px 6px; border-radius: 5px;
    background: var(--glass-chip); border: 1px solid var(--hairline);
  }

  .reel {
    width: 100%; display: block; border-radius: 16px; background: #000;
    border: 1px solid var(--hairline); aspect-ratio: 9 / 16;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 28px; }
  .btn {
    font: inherit; font-size: .9rem; font-weight: 700; cursor: pointer;
    padding: 12px 20px; border-radius: 999px; min-height: 44px;
    border: 1px solid var(--hairline); background: var(--glass-chip);
    color: var(--ink-2); text-decoration: none;
    display: inline-flex; align-items: center;
  }
  .btn.primary { background: var(--anchor); color: var(--on-anchor); border-color: var(--anchor); }

  .block { margin: 0 0 22px; }
  h2 { font-family: var(--display); font-size: 1rem; margin: 0 0 8px; }
  pre {
    white-space: pre-wrap; overflow-wrap: anywhere; margin: 0;
    padding: 15px; border-radius: 12px; background: var(--glass);
    border: 1px solid var(--hairline); font: inherit; font-size: .92rem;
    line-height: 1.55; color: var(--ink-2);
  }
  .note { font-size: .88rem; color: var(--ink-3); line-height: 1.55; margin: 0 0 12px; }
</style>

<script>
  // navigator.clipboard needs a secure context and is missing from a few
  // mobile in-app browsers, so a failure says so rather than doing nothing.
  for (const btn of document.querySelectorAll('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const text = document.getElementById(btn.dataset.copy)?.textContent ?? '';
      const was = btn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select it by hand';
      }
      setTimeout(() => { btn.textContent = was; }, 2000);
    });
  }
</script>
