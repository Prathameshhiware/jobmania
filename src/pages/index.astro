---
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import { getLatest, getClosingSoon, getFacets } from '../lib/db.js';
import { citySlug, CATEGORIES, TYPE_LABEL } from '../lib/format.js';
import {
  titles, descriptions, organizationSchema, websiteSchema, itemListSchema, faqSchema,
} from '../lib/seo.js';

const [latest, closing, facets] = await Promise.all([
  getLatest(6),
  getClosingSoon(5),
  getFacets(),
]);

const origin = (Astro.site?.origin ?? 'https://jobmania.vercel.app').replace(/\/$/, '');

// Answer-engine surface: these are the questions a model gets asked about a
// job site, answered from facts this site can actually stand behind.
const homeFaq = faqSchema([
  {
    q: 'Are the job openings on JoBmania still open?',
    a: `Every listing is re-tested daily against the employer's own application link. ` +
       `Anything returning a 404 or past its deadline is removed within 24 hours, so the ` +
       `${facets.total} openings currently listed all responded on the last check.`,
  },
  {
    q: 'Does JoBmania charge candidates a fee?',
    a: 'No. JoBmania never charges candidates, and no legitimate employer asks a candidate ' +
       'for a registration fee, security deposit or training charge. Listings that request ' +
       'money are flagged and removed.',
  },
  {
    q: 'Why do some listings show no salary?',
    a: 'Because the employer did not publish one. JoBmania shows pay only when the employer ' +
       'states it and never estimates a range, so an empty salary field means the information ' +
       'does not exist upstream rather than that it is unknown.',
  },
  {
    q: 'How do walk-in interview listings work?',
    a: 'A walk-in has no online application — you attend in person. Each walk-in listing shows ' +
       'the venue, the date range and the timing where the employer published them. Confirm with ' +
       'the employer before travelling, as drives can be cancelled at short notice.',
  },
]);

const ICONS = {
  'just-posted': 'M13 2 4.5 13H11l-1 9 8.5-11H12l1-9Z',
  'freshers':    'm12 3 9 5-9 5-9-5 9-5Z',
  'experienced': 'M2 7h20v14H2zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
  'remote':      'M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z',
  'walk-ins':    'M3 4h18v18H3zM8 2v4M16 2v4M3 10h18',
  'internships': 'M12 20v-8M6 20V10M18 20V4',
  'off-campus':  'M12 3 3 8h18l-9-5ZM5 21h14M6 11v7M10 11v7M14 11v7M18 11v7',
};

const countFor = (c) => {
  if (c.slug === 'just-posted') return facets.addedToday;
  if (c.facet.remote) return facets.remote;
  if (c.facet.level) return facets.levels[c.facet.level] ?? 0;
  if (c.facet.hiringType) return facets.types[c.facet.hiringType] ?? 0;
  return facets.total;
};
---
<Base
  title={titles.home(facets.total)}
  description={descriptions.home(facets.total, facets.addedToday)}
  maxAge={180}
  schema={[
    organizationSchema(origin),
    websiteSchema(origin),
    homeFaq,
    latest.length ? itemListSchema(origin, latest, { name: 'Recently posted job openings in India' }) : null,
  ]}
>
  <header class="hero">
    <p class="pill"><span class="dot"></span>{facets.total.toLocaleString('en-IN')} live openings · {facets.addedToday} added today</p>
    <h1>Find the door that’s <em>still open</em>.</h1>
    <p class="lede">Most job sites leave dead listings up for years. We re-check every opening against the employer’s own careers page, every single day.</p>

    <form class="search glass" action="/jobs" method="get">
      <div class="field">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="q" name="q" type="search" placeholder="Role, skill or company" aria-label="Role, skill or company">
      </div>
      <span class="divider"></span>
      <div class="field city">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <input id="city" name="city" type="text" list="cities" placeholder="City" aria-label="City">
        <datalist id="cities">{facets.cities.map(([c]) => <option value={c}></option>)}</datalist>
      </div>
      <button class="btn" type="submit">Search jobs</button>
    </form>
  </header>

  <section>
    <div class="sec-head"><h2>Browse by category</h2></div>
    <p class="sub">Counts update as openings come in and drop out.</p>
    <div class="grid-cat">
      {CATEGORIES.map((c) => (
        <a class={`tile ${c.slug === 'walk-ins' ? 'dark' : 'glass'}`} href={`/c/${c.slug}`}>
          <span class="ico">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONS[c.slug]}/></svg>
          </span>
          <h3>{c.label}</h3>
          <p>{countFor(c)} {c.slug === 'just-posted' ? 'today' : 'openings'}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="sec-head">
      <h2>Just posted</h2>
      <span class="status"><span class="dot"></span>updated continuously</span>
      <a class="more" href="/jobs">See all {facets.total}</a>
    </div>
    <p class="sub">Straight from each employer’s careers feed, link-checked before it appears here.</p>
    {latest.length
      ? <div class="grid-job">{latest.map((job) => <JobCard job={job} />)}</div>
      : <p class="empty glass">No live openings right now. The monitor runs every ten minutes.</p>}
  </section>

  {facets.cities.length > 0 && (
    <section>
      <div class="sec-head"><h2>Jobs by location</h2></div>
      <p class="sub">Every city we currently have live openings in.</p>
      <div class="grid-city">
        {facets.cities.map(([city, n]) => (
          <a class="city-tile glass" href={`/city/${citySlug(city)}`}>
            <span class="ico">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span><h3>{city}</h3><p>{n} opening{n === 1 ? '' : 's'}</p></span>
          </a>
        ))}
      </div>
    </section>
  )}

  {closing.length > 0 && (
    <section>
      <div class="sec-head"><h2>Closing this week</h2></div>
      <p class="sub">Deadlines inside the next seven days.</p>
      <div class="grid-job">{closing.slice(0, 3).map((job) => <JobCard job={job} compact />)}</div>
    </section>
  )}

  {facets.companies.length > 0 && (
    <section>
      <div class="sec-head"><h2>Hiring most right now</h2></div>
      <p class="sub">Employers with the most live openings on JoBmania today.</p>
      <div class="co-row">
        {facets.companies.slice(0, 12).map((c) => (
          <a class="chip" href={`/company/${c.slug}`}>{c.name} · {c.n}</a>
        ))}
      </div>
    </section>
  )}

  <section class="why glass" id="why">
    <h2>Why JoBmania</h2>
    <p class="sub">Four promises, and each one is a thing our system does every day — not a slogan.</p>
    <div class="why-grid">
      <div><h3>Checked every day</h3><p>We test every apply link daily. Dead ones disappear within 24 hours instead of sitting there for years.</p></div>
      <div><h3>Real pay only</h3><p>Pay shows only when the employer states it. We never invent a range to make a listing look better.</p></div>
      <div><h3>Facts, not filler</h3><p>If the employer did not publish something, we say so rather than guessing on your behalf.</p></div>
      <div><h3>No fees, ever</h3><p>We flag listings that ask for money and remove them. No genuine employer charges you to apply.</p></div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 64px 12px; max-width: 900px; }
  .pill { display: inline-flex; align-items: center; gap: 10px; background: var(--glass-chip); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-edge); padding: 9px 18px; border-radius: 999px; font-size: 13px; font-weight: 600; color: var(--ink); }
  .hero h1 { font-size: clamp(38px, 6.4vw, 66px); font-weight: 800; line-height: 1.03; letter-spacing: -0.055em; margin-top: 26px; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .lede { margin: 22px 0 0; font-size: 17px; font-weight: 500; color: var(--ink-2); max-width: 52ch; }

  .search { margin-top: 36px; border-radius: 24px; padding: 14px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .field { flex: 1 1 240px; display: flex; align-items: center; gap: 12px; padding-left: 10px; color: var(--ink-4); }
  .field.city { flex: 0 1 210px; }
  .field input { width: 100%; min-height: 50px; padding: 0; font: inherit; font-size: 16px; color: var(--ink); background: transparent; border: 0; }
  .field input::placeholder { color: var(--ink-4); }
  .divider { width: 1px; align-self: stretch; margin-block: 10px; background: var(--hairline); }
  .search .btn { min-height: 54px; padding-inline: 34px; border-radius: 17px; font-size: 15px; flex: 0 0 auto; }

  section { padding-block: 60px 0; }
  .grid-cat { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 18px; }
  .tile { border-radius: 26px; padding: 26px; text-decoration: none; color: var(--ink); display: block; }
  .tile .ico { width: 46px; height: 46px; border-radius: 15px; margin-bottom: 20px; background: var(--glass-chip); border: 1px solid var(--glass-edge); display: flex; align-items: center; justify-content: center; color: var(--accent); }
  .tile h3 { font-size: 17px; font-weight: 700; letter-spacing: -0.035em; margin-bottom: 6px; }
  .tile p { margin: 0; font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .tile.dark { background: var(--anchor); color: var(--on-anchor); box-shadow: 0 18px 42px -18px var(--shadow); }
  .tile.dark .ico { background: rgba(255,255,255,0.13); border-color: rgba(255,255,255,0.2); color: var(--anchor-icon); }
  .tile.dark p { color: rgba(255,255,255,0.78); }

  .grid-job { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .empty { border-radius: 22px; padding: 28px; margin: 0; color: var(--ink-2); }

  .grid-city { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .city-tile { border-radius: 22px; padding: 22px 24px; display: flex; align-items: center; gap: 16px; text-decoration: none; color: var(--ink); }
  .city-tile .ico { width: 44px; height: 44px; border-radius: 999px; background: var(--glass-chip); border: 1px solid var(--glass-edge); display: flex; align-items: center; justify-content: center; color: var(--accent); flex: none; }
  .city-tile h3 { font-size: 16px; font-weight: 700; letter-spacing: -0.035em; }
  .city-tile p { margin: 4px 0 0; font-size: 13px; font-weight: 500; color: var(--ink-3); }

  .co-row { display: flex; gap: 10px; flex-wrap: wrap; }

  .why { border-radius: 32px; padding: 44px clamp(22px, 4vw, 44px); margin-top: 72px; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 26px; }
  .why-grid h3 { font-size: 17px; font-weight: 700; letter-spacing: -0.035em; margin-bottom: 9px; }
  .why-grid p { margin: 0; font-size: 14px; color: var(--ink-2); }
</style>
