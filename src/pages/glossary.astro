---
// The words on an Indian job offer, explained.
//
// This page exists because of something we measured. Of 405 live listings
// carrying the employer's own description, 132 say "hybrid" and not one says
// "CTC" or "LPA". That is not because those words do not matter in India — it
// is because most of our descriptions come from the global boards of
// companies like Okta, Stripe and MongoDB, who write in global corporate
// English. The vocabulary a fresher actually trips over is missing from our
// own listings, so it needed somewhere to live.
//
// It is also the destination the social posts were missing. A card that
// defines CTC used to end by pointing at /insights, which explains nothing in
// particular. Now it points here, at the term itself.
//
// Statutory entries carry the governing Act and a link to the source, and
// deliberately state no rate, threshold or percentage. Those change by
// notification, and a number on a page that nobody revisits is worse than no
// number at all.

import Base from '../layouts/Base.astro';
import { GLOSSARY } from '../lib/glossary.js';
import { breadcrumbSchema, collectionPageSchema, faqSchema } from '../lib/seo.js';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');

const slug = (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const question = (t) => t.question ?? `What is ${t.term}?`;

// Grouped the way a reader meets them, not alphabetically. Someone holding an
// offer letter wants the pay section, not to scroll past "aptitude test".
const GROUPS = [
  { id: 'pay', name: 'Pay and the offer',
    blurb: 'What the numbers on an offer actually mean, and which of them reach your bank account.',
    terms: ['CTC', 'In-hand salary', 'LPA', 'Basic salary', 'HRA', 'Variable pay', 'Joining bonus', 'ESOP', 'Stipend'] },
  { id: 'law', name: 'The ones set by law',
    blurb: 'Defined by statute rather than custom. Each names the Act it comes from and where to check the current position.',
    terms: ['Provident Fund', 'Gratuity', 'ESIC', 'Form 16', 'TDS', 'Apprenticeship'] },
  { id: 'joining', name: 'Joining and leaving',
    blurb: 'The paperwork around starting a job and getting out of one cleanly.',
    terms: ['Offer letter', 'Appointment letter', 'Notice period', 'Probation', 'Bond', 'Relieving letter', 'BGV', 'Immediate joiner'] },
  { id: 'hiring', name: 'The hiring process',
    blurb: 'What each stage is called and what it is actually testing.',
    terms: ['Walk-in interview', 'Off-campus drive', 'ATS', 'Shortlisted', 'Aptitude test', 'Group discussion', 'HR round'] },
  { id: 'work', name: 'How the work is set up',
    blurb: 'Who employs you, where you sit, and what that changes.',
    terms: ['GCC', 'Third-party payroll', 'Bench', 'Rotational shift', 'Hybrid', 'Internship'] },
];

const byTerm = new Map(GLOSSARY.map((t) => [t.term, t]));
const groups = GROUPS.map((g) => ({ ...g, items: g.terms.map((n) => byTerm.get(n)).filter(Boolean) }));

// Anything added to glossary.js but not placed in a group above still appears,
// rather than silently vanishing from the page.
const placed = new Set(GROUPS.flatMap((g) => g.terms));
const rest = GLOSSARY.filter((t) => !placed.has(t.term));
if (rest.length) {
  groups.push({ id: 'more', name: 'More terms', blurb: '', items: rest });
}

const statutory = GLOSSARY.filter((t) => t.tier === 'statutory').length;

const title = 'Job terms in India, explained';
const seoTitle = 'Indian Job Terms Explained: CTC, In-Hand Salary & More';
const metaDescription =
  `What CTC, in-hand salary, notice period, gratuity and ${GLOSSARY.length - 4} other Indian job terms actually mean. Plain English, no jargon, free.`;

const schema = [
  breadcrumbSchema(origin, [['Home', '/'], ['Glossary', '/glossary']]),
  collectionPageSchema(origin, { path: '/glossary', name: title, description: metaDescription }),
  // Answer engines quote a question and answer far more readily than a
  // definition list, and every term here is already phrased as a question.
  faqSchema(GLOSSARY.map((t) => ({ q: question(t), a: t.short }))),
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    name: title,
    description: metaDescription,
    url: `${origin}/glossary`,
    hasDefinedTerm: GLOSSARY.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.expand ? `${t.term} (${t.expand})` : t.term,
      description: t.short,
      url: `${origin}/glossary#${slug(t.term)}`,
    })),
  },
];
---

<Base title={seoTitle} description={metaDescription} schema={schema} maxAge={86400}>
  <main class="wrap">
    <header class="head">
      <p class="eyebrow">Glossary</p>
      <h1>{title}</h1>
      <p class="dek">
        Every one of these turns up on an Indian job offer or in an interview, and none of them is
        ever explained to you. {GLOSSARY.length} terms in plain English.
      </p>
      <p class="note">
        {statutory} of them are set by law rather than by custom. Those name the Act they come from
        and link to the source, and deliberately quote no rates or limits — those change by
        notification, and a stale number is worse than none.
      </p>
    </header>

    <nav class="jump" aria-label="Sections">
      {groups.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
    </nav>

    {groups.map((g) => (
      <section class="group" id={g.id}>
        <h2>{g.name}</h2>
        {g.blurb && <p class="blurb">{g.blurb}</p>}
        <dl>
          {g.items.map((t) => (
            <div class="term" id={slug(t.term)}>
              <dt>
                {t.term}
                {t.expand && <span class="expand">{t.expand}</span>}
                {t.tier === 'statutory' && <span class="tag">set by law</span>}
              </dt>
              <dd>
                <p>{t.short}</p>
                <p class="why">{t.why}</p>
                {t.tier === 'statutory' && (
                  <p class="act">
                    {t.act}. Rates and limits change, so check
                    {' '}<a href={`https://${t.source}`} rel="nofollow noopener" target="_blank">{t.source}</a>
                    {' '}for the current position.
                  </p>
                )}
                {t.path && <p class="more"><a href={t.path}>Read more</a></p>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <section class="group">
      <h2>Start looking</h2>
      <p class="blurb">Openings we have checked, with the employer’s own description and a link straight to their form.</p>
      <ul class="links">
        <li><a href="/c/freshers">Fresher jobs</a></li>
        <li><a href="/c/walk-ins">Walk-in interviews</a></li>
        <li><a href="/c/internships">Internships</a></li>
        <li><a href="/c/off-campus">Off-campus drives</a></li>
        <li><a href="/c/remote">Work from home</a></li>
        <li><a href="/jobs">All openings</a></li>
      </ul>
      <p class="note">No registration fee, ever. No genuine employer in India asks a candidate for money at any stage.</p>
    </section>
  </main>
</Base>

<style>
  .wrap { max-width: 760px; margin: 0 auto; padding: 32px 16px 80px; }
  .head { margin-bottom: 30px; }
  .eyebrow {
    font-size: .78rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink-3); margin: 0 0 10px;
  }
  h1 { font-family: var(--display); font-size: clamp(1.7rem, 6vw, 2.6rem); line-height: 1.12; margin: 0 0 14px; }
  .dek { font-size: 1.06rem; line-height: 1.55; color: var(--ink-2); margin: 0 0 12px; }
  .note { font-size: .9rem; line-height: 1.55; color: var(--ink-3); margin: 0; }

  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 36px; }
  .jump a {
    padding: 7px 14px; border-radius: 999px; border: 1px solid var(--hairline);
    background: var(--glass-chip); color: var(--ink-2); text-decoration: none;
    font-size: .85rem; font-weight: 600;
  }

  .group { margin: 0 0 42px; scroll-margin-top: 20px; }
  h2 { font-family: var(--display); font-size: 1.3rem; margin: 0 0 8px; }
  .blurb { font-size: .95rem; color: var(--ink-3); line-height: 1.5; margin: 0 0 20px; }

  dl { margin: 0; }
  .term {
    padding: 18px 0; border-top: 1px solid var(--hairline); scroll-margin-top: 20px;
  }
  dt {
    font-family: var(--display); font-weight: 700; font-size: 1.12rem; color: var(--ink);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-bottom: 8px;
  }
  .expand { font-family: var(--body); font-weight: 400; font-size: .9rem; color: var(--ink-3); }
  .tag {
    font-family: var(--body); font-size: .72rem; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; padding: 3px 9px; border-radius: 999px;
    background: var(--warn-soft); border: 1px solid var(--warn-line); color: var(--warn-ink);
  }
  dd { margin: 0; }
  dd p { margin: 0 0 7px; line-height: 1.55; color: var(--ink-2); overflow-wrap: anywhere; }
  .why { color: var(--ink-3); font-size: .94rem; }
  .act { font-size: .86rem; color: var(--ink-3); }
  .act a { color: var(--accent); }
  .more a { font-size: .9rem; font-weight: 600; color: var(--accent); }

  .links { list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 8px; }
  .links a {
    display: block; padding: 8px 15px; border-radius: 999px;
    background: var(--anchor); color: var(--on-anchor); text-decoration: none;
    font-size: .88rem; font-weight: 600;
  }
</style>
