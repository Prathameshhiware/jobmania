---
// One kind of writing — /insights/blogs, /insights/playbook, and so on.
//
// Kept noindex while empty. A section with nothing in it is a thin page, and
// thin pages entering the index drag down how the whole domain is judged; it
// becomes indexable the moment it has something to show.
import { getCollection } from 'astro:content';
import { generatedPosts } from '../../../lib/posts.js';
import Base from '../../../layouts/Base.astro';
import { KINDS, KIND_ORDER, kindBySlug, articlePath, fmtDate, readingMinutes, publish } from '../../../lib/insights.js';
import { breadcrumbSchema, collectionPageSchema } from '../../../lib/seo.js';

const kind = kindBySlug(Astro.params.kind);
if (!kind) return Astro.rewrite('/404');

const meta = KINDS[kind];
// Authored markdown and machine-written posts, in one list. The roundup is
// a database row rather than a file, but a reader should not be able to tell
// from the index which is which.
const items = publish([...(await getCollection('insights')), ...(await generatedPosts())])
  .filter((e) => e.data.kind === kind);

const origin = (Astro.site?.origin ?? 'https://jobmania.dpdns.org').replace(/\/$/, '');
const others = KIND_ORDER.filter((k) => k !== kind);
---
<Base
  title={`${meta.seoTitle ?? meta.label} | JoBmania`}
  description={meta.metaDescription ?? meta.blurb}
  noindex={items.length === 0}
  maxAge={900}
  schema={[
    collectionPageSchema(origin, {
      path: `/insights/${meta.slug}`,
      name: `JoBmania ${meta.label}`,
      description: meta.blurb,
    }),
    breadcrumbSchema(origin, [
      { name: 'Home', path: '/' },
      { name: 'Insights', path: '/insights' },
      { name: meta.label },
    ]),
  ]}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>›<a href="/insights">Insights</a>›<span>{meta.label}</span>
  </nav>

  <header class="lead">
    <h1>{meta.label}</h1>
    <p class="sub">{meta.blurb}</p>
  </header>

  {items.length > 0 ? (
    <ol class="list">
      {items.map((e) => (
        <li>
          <a class="row glass" href={articlePath(e)}>
            <div class="row-main">
              <h2>{e.data.title}</h2>
              <p>{e.data.dek}</p>
            </div>
            <div class="row-meta">
              <time datetime={e.data.published.toISOString()}>{fmtDate(e.data.published)}</time>
              <span>{readingMinutes(e.body)} min</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="empty glass">Nothing here yet. It stays empty rather than padded.</p>
  )}

  <nav class="switch" aria-label="Other sections">
    {others.map((k) => (
      <a class="chip" href={`/insights/${KINDS[k].slug}`}>{KINDS[k].label}</a>
    ))}
  </nav>
</Base>

<style>
  .crumbs { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; font-size: 13px; color: var(--ink-3); padding-block: 22px 0; }
  .crumbs a { color: var(--ink-2); text-decoration: none; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; }

  .lead { padding-block: 40px 28px; max-width: 640px; }
  .lead h1 { font-size: clamp(30px, 5vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -0.05em; }
  .sub { margin: 16px 0 0; font-size: 16px; font-weight: 500; line-height: 1.65; color: var(--ink-2); }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .row { display: flex; gap: 24px; align-items: flex-start; border-radius: 20px; padding: 24px 26px; text-decoration: none; color: var(--ink); }
  .row-main { flex: 1 1 auto; }
  .row h2 { font-size: 19px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.3; margin-bottom: 8px; }
  .row p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-3); }
  .row-meta { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 5px; font-size: 12px; color: var(--ink-4); }

  .empty { border-radius: 20px; padding: 30px; margin: 0; font-size: 15px; color: var(--ink-2); }

  .switch { display: flex; gap: 10px; flex-wrap: wrap; padding-block: 44px 0; }

  @media (max-width: 620px) {
    .row { flex-direction: column; gap: 12px; padding: 20px; }
    .row-meta { flex-direction: row; align-items: center; gap: 10px; }
  }
</style>
