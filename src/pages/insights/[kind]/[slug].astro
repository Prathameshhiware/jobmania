---
// One article. The URL carries its kind — /insights/playbook/<slug> — so the
// path itself says what a reader is about to get, and a piece of guidance never
// sits at the same address as an argument.
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { KINDS, kindBySlug, articlePath, fmtDate, readingMinutes, publish } from '../../../lib/insights.js';
import { generatedPost, generatedPosts } from '../../../lib/posts.js';
import { breadcrumbSchema, faqSchema } from '../../../lib/seo.js';

// One place, so changing where removal requests go is a one line edit.
const CONTACT_EMAIL = 'connect@jobmania.dpdns.org';

const kind = kindBySlug(Astro.params.kind);
if (!kind) return Astro.rewrite('/404');

// Two homes, one section. Pieces a person wrote are markdown in the repo;
// the weekly roundup is a row in the database, because without a CI runner
// nothing can commit a file. Both arrive here in the same shape.
const authored = await getCollection('insights');
let entry = publish(authored).find((e) => e.id === Astro.params.slug && e.data.kind === kind);
if (!entry) {
  const row = await generatedPost(Astro.params.slug);
  if (row && row.data.kind === kind) entry = row;
}
if (!entry) return Astro.rewrite('/404');

// Authored markdown goes through Astro's renderer. A generated post is already
// HTML, built by src/lib/roundup.js, and is set straight into the page.
const Content = entry.generated ? null : (await render(entry)).Content;
const meta = KINDS[kind];
const d = entry.data;

const origin = (Astro.site?.origin ?? 'https://jobmania.dpdns.org').replace(/\/$/, '');
const url = `${origin}${articlePath(entry)}`;
const mins = readingMinutes(entry.body);

// Same kind, newest first, this one excluded. Drawn from both homes so a
// roundup can point at an essay and an essay can point back.
const more = publish([...authored, ...(await generatedPosts())])
  .filter((e) => e.data.kind === kind && e.id !== entry.id)
  .slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': meta.schema,
  headline: d.title,
  description: d.dek,
  datePublished: d.published.toISOString(),
  dateModified: (d.updated ?? d.published).toISOString(),
  // Published by the site rather than credited to an individual.
  author: { '@type': 'Organization', name: 'JoBmania', url: origin },
  publisher: {
    '@type': 'Organization',
    name: 'JoBmania',
    url: origin,
    logo: { '@type': 'ImageObject', url: `${origin}/icon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'en-IN',
  isAccessibleForFree: true,
  // Reports state the moment their numbers were true. A statistic without one
  // is unfalsifiable, and an answer engine has no way to know it has gone stale.
  ...(d.dataAsOf ? { temporalCoverage: d.dataAsOf.toISOString().slice(0, 10) } : {}),
  ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
  // A generated post cites its stories without listing them twice: the links
  // are already in the body with their publisher and date.
  ...(d.sources.length
    ? { citation: d.sources.map((s) => s.url) }
    : d.citations?.length
      ? { citation: d.citations }
      : {}),
};
---
<Base
  title={d.seoTitle ? `${d.seoTitle} | JoBmania` : `${d.title} | JoBmania`}
  description={d.metaDescription ?? d.dek}
  maxAge={1800}
  schema={[
    articleSchema,
    breadcrumbSchema(origin, [
      { name: 'Home', path: '/' },
      { name: 'Insights', path: '/insights' },
      { name: meta.label, path: `/insights/${meta.slug}` },
      { name: d.title },
    ]),
    d.faq.length ? faqSchema(d.faq) : null,
  ].filter(Boolean)}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>›<a href="/insights">Insights</a>›<a href={`/insights/${meta.slug}`}>{meta.label}</a>
  </nav>

  <article>
    <header class="head">
      <span class="kind">{meta.one}</span>
      <h1>{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <p class="byline">
        <time datetime={d.published.toISOString()}>{fmtDate(d.published)}</time>
        {d.updated && <><span class="dot"></span><span>updated {fmtDate(d.updated)}</span></>}
        <span class="dot"></span>
        <span>{mins} min read</span>
      </p>

    </header>

    <div class="prose">{entry.generated ? <Fragment set:html={entry.html} /> : <Content />}</div>

    {/* Rendered as well as emitted as FAQPage schema. A question block a reader
        can actually see is what a search engine expands into a rich result, and
        what an answer engine quotes; schema alone with nothing on the page is a
        structured-data violation. */}
    {d.faq.length > 0 && (
      <section class="faq">
        <h2>Frequently asked questions</h2>
        <dl>
          {d.faq.map((f) => (
            <div class="qa">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="sources glass">
        <h2>Sources</h2>
        <ol>
          {d.sources.map((s) => (
            <li><a href={s.url} rel="nofollow noopener noreferrer" target="_blank">{s.label}</a></li>
          ))}
        </ol>
      </section>
    )}

    {/* Deliberately quiet. It is a standing offer to the publishers we cite,
        not a disclaimer aimed at the reader, so it sits at the foot of the page
        at a size that does not compete with the article. Rendered on every
        piece rather than only the ones with a Sources list: the weekly roundup
        carries its references inline in the text, and that is the page most in
        need of the notice. */}
    <p class="rights">
      Headlines, figures and quotations in this article belong to the publishers linked
      {d.sources.length > 0 ? ' above' : ' in the text above'}, and are credited to them. If you
      own one of these sources and would rather we did not reference it, write to{' '}
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we will remove it.
    </p>

    <aside class="ledger">
      <h2>How to read this</h2>
      <p>
        Everything on JoBmania belongs to one of three categories. Measured means our own
        system produced the number. Extracted means it appeared in the employer's own posting.
        Authored means it was written deliberately rather than generated to fill space.
        Everything in this section is authored, and any figure taken from our own database
        carries the date it was measured.
      </p>
    </aside>
  </article>

  {more.length > 0 && (
    <section class="more">
      <h2>More {meta.label.toLowerCase()}</h2>
      <div class="more-grid">
        {more.map((e) => (
          <a class="card glass" href={articlePath(e)}>
            <span class="kind sm">{KINDS[e.data.kind].one}</span>
            <h3>{e.data.title}</h3>
            <p>{e.data.dek}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="cta">
    <h2>Looking for an opening rather than a read?</h2>
    <a class="btn" href="/jobs">Browse live jobs</a>
  </section>
</Base>

<style>
  .crumbs { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; font-size: 13px; color: var(--ink-3); padding-block: 22px 0; }
  .crumbs a { color: var(--ink-2); text-decoration: none; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; }

  article { max-width: 720px; }
  .head { padding-block: 34px 8px; }
  .kind { display: inline-flex; align-items: center; height: 26px; padding-inline: 12px; border-radius: 999px; background: var(--glass-chip); border: 1px solid var(--glass-edge); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); }
  .head h1 { font-size: clamp(30px, 5vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -0.05em; margin-top: 18px; }
  .dek { margin: 18px 0 0; font-size: 18px; font-weight: 500; line-height: 1.6; color: var(--ink-2); }
  .byline { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 22px 0 0; font-size: 13px; color: var(--ink-3); }
  .byline .dot { width: 3px; height: 3px; border-radius: 999px; background: var(--ink-4); }


  /* The article body. Astro renders the markdown; these rules are the only
     styling it gets, so they have to cover every element markdown can emit. */
  .prose { padding-block: 34px 0; font-size: 17px; line-height: 1.75; color: var(--ink-2); }
  .prose :global(h2) { font-size: clamp(22px, 3vw, 29px); font-weight: 800; letter-spacing: -0.04em; color: var(--ink); margin: 46px 0 14px; }
  .prose :global(h3) { font-size: 19px; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); margin: 34px 0 10px; }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(strong) { color: var(--ink); font-weight: 700; }
  .prose :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 22px; padding-left: 22px; }
  .prose :global(li) { margin-bottom: 9px; }
  .prose :global(blockquote) { margin: 26px 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--accent); color: var(--ink); font-size: 19px; font-weight: 500; }
  .prose :global(hr) { border: 0; height: 1px; background: var(--hairline); margin: 40px 0; }
  .prose :global(code) { font-size: 0.9em; background: var(--glass-chip); border: 1px solid var(--glass-edge); border-radius: 6px; padding: 2px 6px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 24px; font-size: 15px; }
  .prose :global(th) { text-align: left; font-weight: 700; color: var(--ink); padding: 10px 12px 10px 0; border-bottom: 1px solid var(--hairline); }
  .prose :global(td) { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .prose :global(table) :global(tr):last-child :global(td) { border-bottom: 0; }

  .faq { padding-block: 46px 0; }
  .faq h2 { font-size: clamp(22px, 3vw, 29px); font-weight: 800; letter-spacing: -0.04em; color: var(--ink); margin-bottom: 20px; }
  .faq dl { margin: 0; display: grid; gap: 12px; }
  .qa { border: 1px solid var(--hairline); border-radius: 16px; padding: 20px 22px; }
  .qa dt { font-size: 16px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); margin-bottom: 8px; }
  .qa dd { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink-2); }

  .sources { border-radius: 20px; padding: 24px 26px; margin-top: 44px; }
  .sources h2 { font-size: 15px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 12px; }
  .sources ol { margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.8; }
  /* 11.5px is small without going under what a phone can comfortably render;
     anything less and it stops being a notice and starts being hidden. */
  .rights {
    margin: 20px 0 0; padding-top: 14px; border-top: 1px solid var(--hairline);
    font-size: 11.5px; line-height: 1.65; color: var(--ink-4);
    max-width: 68ch; overflow-wrap: break-word;
  }
  .rights a { color: var(--ink-3); text-decoration: underline; text-underline-offset: 2px; }
  .sources a { color: var(--accent); }

  .ledger { margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--hairline); }
  .ledger h2 { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-4); margin-bottom: 9px; }
  .ledger p { margin: 0; font-size: 13.5px; line-height: 1.7; color: var(--ink-3); }

  .more { padding-block: 60px 0; }
  .more h2 { font-size: clamp(20px, 2.6vw, 26px); font-weight: 800; margin-bottom: 20px; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
  .card { border-radius: 22px; padding: 24px; text-decoration: none; color: var(--ink); display: block; }
  .card .sm { height: 22px; font-size: 10px; }
  .card h3 { font-size: 17px; font-weight: 700; letter-spacing: -0.03em; margin: 14px 0 8px; line-height: 1.25; }
  .card p { margin: 0; font-size: 13.5px; color: var(--ink-3); line-height: 1.6; }

  .cta { padding-block: 56px 0; text-align: center; }
  .cta h2 { font-size: clamp(20px, 2.6vw, 26px); font-weight: 800; margin-bottom: 18px; }

  @media (max-width: 620px) {
    .prose { font-size: 16.5px; }
    .dek { font-size: 16.5px; }
  }
</style>
