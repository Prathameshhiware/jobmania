---
import Base from '../../layouts/Base.astro';
import JobList from '../../components/JobList.astro';
import { getByFacet, getFacets } from '../../lib/db.js';
import { citySlug } from '../../lib/format.js';

const { city } = Astro.params;
const facets = await getFacets();
const match = facets.cities.find(([name]) => citySlug(name) === city);
if (!match) return Astro.redirect('/404', 404);

const [name, count] = match;
const jobs = await getByFacet({ city: name }, 60);
const sub = `Live job openings in ${name}, re-checked daily against each employer’s own careers page. Walk-ins show their venue and timing so you can confirm before travelling.`;
---
<Base
  title={`Jobs in ${name} — ${count} live openings | JoBmania`}
  description={sub}
  noindex={jobs.length < 3}
>
  <JobList heading={`Jobs in ${name}`} sub={sub} jobs={jobs} crumb={name} />
</Base>
