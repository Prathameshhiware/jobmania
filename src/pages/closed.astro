---
// Roles that have closed. Every job site claims to keep listings current; this
// is the page that shows it. Publishing what we removed, and why, is the only
// version of that claim a reader can actually check.
//
// Deliberately noindex: Google's guidance is that expired postings should not
// be in the index, and chasing search traffic with closed roles would be the
// exact behaviour this site exists to avoid. It is here for people, not rankings.
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import { getRecentlyClosed, closedBreakdown, getFacets } from '../lib/db.js';

const [closed, tally, facets] = await Promise.all([
  getRecentlyClosed(36),
  closedBreakdown(),
  getFacets(),
]);

const num = (v) => Number(v ?? 0).toLocaleString('en-IN');
---
<Base
  title="Recently closed roles | JoBmania"
  description="Openings we have taken down, and why: finished walk-in drives, passed deadlines, and application links that stopped working. Published so the freshness claim can be checked rather than taken on trust."
  noindex
  maxAge={600}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>›<span>Recently closed</span>
  </nav>

  <header class="lead">
    <h1>Recently closed</h1>
    <p class="sub">
      Every job site says its listings are current. This is the page that lets you
      check. These roles were live on JoBmania and have since been taken down,
      and each one shows why.
    </p>

    <div class="stats">
      <div class="stat"><b>{num(tally.total)}</b><span>taken down in total</span></div>
      <div class="stat"><b>{num(tally.finishedDrives)}</b><span>drives that finished</span></div>
      <div class="stat"><b>{num(tally.deadlinePassed)}</b><span>deadlines that passed</span></div>
      <div class="stat"><b>{num(tally.deadLinks)}</b><span>links that stopped working</span></div>
      <div class="stat live"><b>{num(facets.total)}</b><span>still open right now</span></div>
    </div>
  </header>

  <div class="note glass">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16h.01"/></svg>
    <p>
      <strong>Do not apply to anything on this page.</strong> These openings are
      over. The deadline passed, the drive finished, or the employer removed the
      application page. They are kept so a stale link lands somewhere useful
      instead of a dead end. Each one links through to live alternatives.
    </p>
  </div>

  {closed.length
    ? <div class="grid-job">{closed.map((job) => <JobCard job={job} />)}</div>
    : <p class="empty glass">Nothing has been taken down yet.</p>}

  <section class="cta">
    <h2>Looking for something open?</h2>
    <p>{facets.total.toLocaleString('en-IN')} roles are live right now, every apply link tested within the last 24 hours.</p>
    <a class="btn" href="/jobs">Browse live openings</a>
  </section>
</Base>

<style>
  .crumbs { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; font-size: 13px; color: var(--ink-3); padding-block: 22px 0; }
  .crumbs a { color: var(--ink-2); text-decoration: none; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; }

  .lead { padding-block: 40px 26px; }
  .lead h1 { font-size: clamp(30px, 5vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -0.05em; }
  .sub { margin: 16px 0 0; font-size: 16px; font-weight: 500; color: var(--ink-2); max-width: 62ch; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin-top: 30px; }
  .stat b { display: block; font-family: var(--display); font-size: clamp(25px, 3.2vw, 33px); font-weight: 800; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .stat span { display: block; margin-top: 9px; font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .stat.live b { color: var(--ok-ink); }

  .note { display: flex; gap: 14px; align-items: flex-start; border-radius: 20px; padding: 20px 24px; margin-bottom: 26px; }
  .note > svg { flex: none; color: var(--warn-ink); margin-top: 2px; }
  .note p { margin: 0; font-size: 14px; line-height: 1.7; color: var(--ink-2); }

  .grid-job { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .empty { border-radius: 22px; padding: 28px; margin: 0; color: var(--ink-2); }

  .cta { padding-block: 56px 0; text-align: center; }
  .cta h2 { font-size: clamp(22px, 3vw, 28px); font-weight: 800; }
  .cta p { margin: 12px 0 22px; font-size: 15px; color: var(--ink-2); }
</style>
