---
import Base from '../../layouts/Base.astro';
import JobCard from '../../components/JobCard.astro';
import { getJobBySlug, getSimilar, getByCompany } from '../../lib/db.js';
import {
  timeAgo, daysLeft, experienceLabel, salaryLabel, locationLabel,
  walkinLabel, citySlug, TYPE_LABEL,
} from '../../lib/format.js';

const { slug } = Astro.params;
const job = await getJobBySlug(slug);

if (!job) return Astro.redirect('/404', 404);

const [similar, sameCompany] = await Promise.all([
  getSimilar(job, 3),
  getByCompany(job.company_slug, 6),
]);
const others = sameCompany.filter((j) => j.slug !== job.slug);

const exp = experienceLabel(job.exp_min, job.exp_max);
const pay = salaryLabel(job);
const where = locationLabel(job);
const walkin = walkinLabel(job);
const left = daysLeft(job.valid_through);
const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : null;

// Facts, restated. Every clause below is a stored field — nothing inferred.
const factSentence = [
  `${job.company_name} is hiring for ${job.title}`,
  where ? ` in ${where}` : '',
  exp ? `, for candidates with ${exp.toLowerCase()} of experience` : '',
  job.qualification ? `. Qualification: ${job.qualification}` : '',
  '.',
].join('');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: job.description_html ?? factSentence,
  datePosted: job.posted_at,
  validThrough: job.valid_through,
  employmentType: job.hiring_type === 'internship' ? 'INTERN' : 'FULL_TIME',
  hiringOrganization: { '@type': 'Organization', name: job.company_name },
  jobLocation: job.is_remote
    ? undefined
    : { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: job.city_primary ?? undefined, addressCountry: 'IN' } },
  jobLocationType: job.is_remote ? 'TELECOMMUTE' : undefined,
  applicantLocationRequirements: job.is_remote ? { '@type': 'Country', name: 'India' } : undefined,
  identifier: { '@type': 'PropertyValue', name: 'JoBmania', value: job.short_id },
  directApply: false,
  // present only when the employer stated it
  baseSalary: (job.salary_min != null || job.salary_max != null) ? {
    '@type': 'MonetaryAmount',
    currency: job.salary_currency ?? 'INR',
    value: {
      '@type': 'QuantitativeValue',
      minValue: job.salary_min ?? undefined,
      maxValue: job.salary_max ?? undefined,
      unitText: job.salary_period ?? 'MONTH',
    },
  } : undefined,
};

const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    job.city_primary && { '@type': 'ListItem', position: 2, name: job.city_primary, item: new URL(`/city/${citySlug(job.city_primary)}`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: job.company_name, item: new URL(`/company/${job.company_slug}`, Astro.site).href },
  ].filter(Boolean),
};

const clean = (o) => JSON.parse(JSON.stringify(o));

// Built here rather than inline: nested template literals inside markup
// expressions do not survive the Astro/esbuild transform.
const verifiedAgo = timeAgo(job.last_verified_at ?? job.posted_at);
const pageTitle = `${job.title} at ${job.company_name}${where ? ` — ${where}` : ''} | JoBmania`;
const pageDesc = `${factSentence} Apply on ${job.company_name}'s official page. Verified ${verifiedAgo}.`;
const deadlineLabel = left == null ? null
  : left <= 0 ? 'Closes today'
  : `${left} day${left === 1 ? '' : 's'} left to apply`;
---
<Base title={pageTitle} description={pageDesc} maxAge={300}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(clean(jsonLd))} />
    <script type="application/ld+json" set:html={JSON.stringify(clean(crumbs))} />
  </Fragment>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>›
    {job.city_primary && <><a href={`/city/${citySlug(job.city_primary)}`}>{job.city_primary}</a>›</>}
    <a href={`/company/${job.company_slug}`}>{job.company_name}</a>›
    <span>{job.title}</span>
  </nav>

  <div class="cols">
    <main class="stack">
      <header class="card glass">
        <div class="head-co">
          <span class="co">{job.company_name}</span><span class="sep"></span>
          <span class="status"><span class="dot"></span>Verified {timeAgo(job.last_verified_at ?? job.posted_at)}</span>
        </div>
        <h1>{job.title}</h1>
        <div class="chips">
          {where && <span class="chip">{where}</span>}
          {exp && <span class="chip">{exp}</span>}
          {job.qualification && <span class="chip">{job.qualification}</span>}
          <span class="chip">{TYPE_LABEL[job.hiring_type] ?? job.hiring_type}</span>
        </div>
        <p class="meta">
          Posted {fmtDate(job.posted_at)}
          {job.valid_through && <> · Applications close {fmtDate(job.valid_through)}</>}
        </p>
      </header>

      {walkin && (
        <section class="card glass walkin">
          <h2 class="sec">Walk-in details</h2>
          <p class="sec-note">As published by the employer. Confirm before you travel.</p>
          <dl class="facts">
            <div class="fact"><dt>Dates</dt><dd>{walkin}</dd></div>
            {job.walkin_time && <div class="fact"><dt>Timing</dt><dd>{job.walkin_time}</dd></div>}
            {job.walkin_venue && <div class="fact wide"><dt>Venue</dt><dd>{job.walkin_venue}</dd></div>}
          </dl>
          {!job.walkin_venue && <p class="absent">The venue was not published in the source listing. Check the employer’s page before travelling.</p>}
        </section>
      )}

      <section class="card glass">
        <h2 class="sec">At a glance</h2>
        <p class="sec-note">Structured from the employer’s listing. A blank field means they did not state it.</p>
        <dl class="facts">
          <div class="fact"><dt>Company</dt><dd>{job.company_name}</dd></div>
          <div class="fact"><dt>Role</dt><dd>{job.title}</dd></div>
          <div class="fact"><dt>Qualification</dt><dd class={job.qualification ? '' : 'none'}>{job.qualification ?? 'Not stated'}</dd></div>
          <div class="fact"><dt>Experience</dt><dd class={exp ? '' : 'none'}>{exp ?? 'Not stated'}</dd></div>
          <div class="fact"><dt>Location</dt><dd class={where ? '' : 'none'}>{where ?? 'Not stated'}</dd></div>
          <div class="fact"><dt>Type</dt><dd>{TYPE_LABEL[job.hiring_type] ?? job.hiring_type}</dd></div>
          <div class="fact"><dt>Pay</dt><dd class={pay ? '' : 'none'}>{pay ?? 'Not stated by the employer'}</dd></div>
          <div class="fact"><dt>Last date</dt><dd>{fmtDate(job.valid_through)}</dd></div>
        </dl>
        <p class="policy">We publish pay only when the employer states it, and never estimate a range.</p>
      </section>

      {job.description_html && (
        <section class="card glass">
          <h2 class="sec">About the role</h2>
          <p class="sec-note">Published by {job.company_name} on their own careers site.</p>
          <div class="jd" set:html={job.description_html} />
        </section>
      )}

      <section class="card glass faq">
        <h2 class="sec">About this listing</h2>
        <p class="sec-note">Answered from what the employer published and from our own records. Anything they did not state, we do not fill in.</p>
        {!pay && (
          <details open>
            <summary>Why is no pay shown?</summary>
            <p>Because {job.company_name} did not state it in this listing. We publish pay only when the employer does and never estimate a range, so a blank field means the information does not exist upstream — not that we failed to find it.</p>
          </details>
        )}
        <details>
          <summary>How current is this listing?</summary>
          <p>We last confirmed the application link was live {timeAgo(job.last_verified_at ?? job.posted_at)}, and we re-check every opening daily. If it closes or the link stops responding, this page is delisted within 24 hours.</p>
        </details>
        {!job.description_html && (
          <details>
            <summary>Where is the full job description?</summary>
            <p>{job.company_name} does not publish this role through a feed we can read, so we hold the facts above but not their full write-up. Rather than guess at the rest, we send you to their official page.</p>
          </details>
        )}
      </section>

      {others.length > 0 && (
        <section>
          <div class="sec-head"><h2>More at {job.company_name}</h2></div>
          <div class="grid-job">{others.slice(0, 2).map((j) => <JobCard job={j} compact />)}</div>
        </section>
      )}
    </main>

    <aside class="stack">
      <div class="card glass aside">
        {deadlineLabel && left <= 14 && (
          <span class="deadline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            {deadlineLabel}
          </span>
        )}
        {job.apply_url
          ? <>
              <a class="btn apply" href={job.apply_url} target="_blank" rel="noopener nofollow ugc">
                Apply on {job.company_name}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
              </a>
              <p class="note">Opens {job.company_name}’s official application page. We never collect your application.</p>
            </>
          : <p class="note">This listing has no online application link — it is a walk-in. Check the venue and timing above.</p>}
      </div>

      <div class="card glass aside">
        <h2 class="sec small">How we verified this</h2>
        <div class="rows">
          <div class="row"><span>Apply link tested</span><span>{timeAgo(job.last_checked_at) ?? '—'}</span></div>
          <div class="row"><span>First seen</span><span>{fmtDate(job.first_seen_at)}</span></div>
          <div class="row"><span>Auto-expires</span><span>{fmtDate(job.valid_through)}</span></div>
          <div class="row"><span>Fee requested</span><span>{job.scam_flags?.length ? 'Flagged' : 'None'}</span></div>
        </div>
        {job.canonical_url && <a class="src" href={job.canonical_url} target="_blank" rel="noopener nofollow">Employer’s own listing →</a>}
      </div>

      {similar.length > 0 && (
        <div class="card glass aside">
          <h2 class="sec small">Similar in {job.city_primary ?? 'India'}</h2>
          <div class="more-list">
            {similar.map((j) => (
              <a href={`/job/${j.slug}`}>
                <span class="t">{j.title}</span>
                <span class="s">{j.company_name}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</Base>

<style>
  .crumbs { display: flex; gap: 9px; flex-wrap: wrap; align-items: center; font-size: 13px; color: var(--ink-3); padding-block: 22px 0; }
  .crumbs a { color: var(--ink-2); text-decoration: none; font-weight: 500; }
  .cols { display: grid; grid-template-columns: minmax(0,1fr) 330px; gap: 22px; align-items: start; padding-block: 18px; }
  @media (max-width: 900px) { .cols { grid-template-columns: minmax(0,1fr); } }
  .stack { display: flex; flex-direction: column; gap: 22px; }

  .head-co { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
  .co { font-size: 15px; font-weight: 700; }
  .sep { width: 3px; height: 3px; border-radius: 999px; background: var(--ink-4); }
  h1 { font-size: clamp(27px, 4.2vw, 38px); font-weight: 800; line-height: 1.14; }
  .chips { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 18px; }
  .meta { margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--hairline); font-size: 13px; color: var(--ink-3); }

  .sec { font-size: clamp(19px, 2.4vw, 23px); font-weight: 800; margin-bottom: 6px; }
  .sec.small { font-size: 16px; margin-bottom: 14px; }
  .sec-note { margin: 0 0 20px; font-size: 13px; color: var(--ink-3); }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0 34px; margin: 0; }
  .fact { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--hairline); font-size: 14px; }
  .fact.wide { grid-column: 1 / -1; }
  .fact dt { flex: 0 0 118px; color: var(--ink-3); margin: 0; }
  .fact dd { margin: 0; font-weight: 600; }
  .fact dd.none { font-weight: 400; color: var(--ink-4); font-style: italic; }
  .policy, .absent { margin: 14px 0 0; font-size: 12px; color: var(--ink-4); }

  .jd { font-size: 15px; color: var(--ink-2); line-height: 1.75; }
  .jd :global(h1), .jd :global(h2), .jd :global(h3) { font-size: 17px; font-weight: 700; margin: 22px 0 8px; color: var(--ink); }
  .jd :global(ul), .jd :global(ol) { padding-left: 20px; }
  .jd :global(a) { color: var(--accent); }

  .faq details { border-bottom: 1px solid var(--hairline); }
  .faq details:last-child { border-bottom: 0; }
  .faq summary { cursor: pointer; list-style: none; padding: 15px 0; font-size: 15px; font-weight: 600; display: flex; gap: 12px; align-items: center; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; margin-left: auto; font-size: 18px; color: var(--ink-4); font-weight: 400; }
  .faq details[open] summary::after { content: "\2013"; }
  .faq p { margin: 0 0 16px; font-size: 14px; color: var(--ink-2); }

  .aside { padding: 24px; border-radius: 24px; }
  .deadline { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: var(--warn-ink); margin-bottom: 16px; }
  .btn.apply { width: 100%; min-height: 52px; font-size: 15px; }
  .note { margin: 12px 0 0; font-size: 12px; color: var(--ink-4); text-align: center; }
  .rows { display: flex; flex-direction: column; }
  .row { display: flex; gap: 12px; justify-content: space-between; padding: 10px 0; font-size: 13px; border-top: 1px solid var(--hairline); }
  .row:first-child { border-top: 0; }
  .row span:first-child { color: var(--ink-3); }
  .row span:last-child { font-weight: 600; text-align: right; }
  .src { display: block; margin-top: 14px; font-size: 13px; font-weight: 600; text-decoration: none; }
  .more-list { display: flex; flex-direction: column; gap: 14px; }
  .more-list a { display: block; text-decoration: none; color: inherit; }
  .more-list .t { display: block; font-size: 14px; font-weight: 600; line-height: 1.35; }
  .more-list .s { display: block; font-size: 12px; color: var(--ink-3); margin-top: 3px; }

  .sec-head { display: flex; align-items: baseline; gap: 14px; }
  .sec-head h2 { font-size: 23px; font-weight: 800; }
  .grid-job { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
</style>
