# Real secrets only. Deliberately NOT `.env*`, which would also swallow
# .env.example — the file that documents which variables are required.
.env
.env.local
.env.*.local

.DS_Store
*.log

# Rendered card previews, written by `npm run cards` for eyeballing locally.
.preview-cards/

# Generated from the .ttf files by scripts/inline-fonts.mjs on every build.
src/fonts/fonts.generated.js

# Which subjects have already been made into reels. Local to the machine
# that builds them.
.reel-history.json
.reel-log.txt

# Batch-rendered reels. Large, regenerable, and perishable.
reels-30day/
