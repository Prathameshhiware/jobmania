# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
# .env.local is gitignored. Never commit real keys.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# service_role key. Writes bypass RLS, so this is a secret.
# Local: .env.local only.  CI: GitHub repo secret.  Never in Vercel client env.
SUPABASE_SERVICE_ROLE_KEY=

# anon key. Safe for the public site (RLS restricts it to live rows).
SUPABASE_ANON_KEY=

# Displayed visitor count = this + real visits.
# The database always stores the TRUE count; set to 0 to show real numbers only.
VISITOR_BASELINE=500
